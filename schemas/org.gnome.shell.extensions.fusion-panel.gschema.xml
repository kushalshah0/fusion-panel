<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.fusion-panel"
          path="/org/gnome/shell/extensions/fusion-panel/">

    <!-- ===== Panel Settings ===== -->
    <key name="panel-position" type="s">
      <default>'BOTTOM'</default>
      <summary>Panel position</summary>
    </key>

    <key name="panel-height" type="i">
      <default>45</default>
      <summary>Panel height</summary>
    </key>

    <key name="panel-margin" type="i">
      <default>0</default>
      <summary>Panel margin</summary>
    </key>

    <key name="panel-border-radius" type="i">
      <default>0</default>
      <summary>Panel border radius</summary>
    </key>

    <key name="panel-bg-color" type="s">
      <default>'rgba(0, 0, 0, 0.3)'</default>
      <summary>Panel background color</summary>
    </key>

    <!-- ===== Multi-Monitor ===== -->
    <key name="multi-monitor" type="b">
      <default>true</default>
      <summary>Show panel on all monitors</summary>
    </key>

    <key name="primary-monitor-only-favorites" type="b">
      <default>false</default>
      <summary>Show favorites only on primary monitor</summary>
    </key>

    <!-- ===== Auto-Hide ===== -->
    <key name="auto-hide" type="b">
      <default>false</default>
      <summary>Auto-hide the panel</summary>
    </key>

    <key name="auto-hide-delay" type="i">
      <default>1000</default>
      <summary>Delay before hiding (ms)</summary>
    </key>

    <key name="auto-hide-animation-duration" type="i">
      <default>200</default>
      <summary>Hide/show animation duration (ms)</summary>
    </key>

    <key name="show-panel-on-overview" type="b">
      <default>true</default>
      <summary>Show panel when overview is open</summary>
    </key>

    <key name="pressure-threshold" type="i">
      <default>100</default>
      <summary>Hot edge pressure threshold to reveal panel</summary>
    </key>

    <!-- ===== Blur Settings ===== -->
    <key name="blur-enabled" type="b">
      <default>true</default>
      <summary>Enable blur</summary>
    </key>

    <key name="blur-sigma" type="i">
      <default>30</default>
      <summary>Blur sigma</summary>
    </key>

    <key name="blur-brightness" type="d">
      <default>0.6</default>
      <summary>Blur brightness</summary>
    </key>

    <key name="dynamic-blur" type="b">
      <default>false</default>
      <summary>Dynamic blur (blur windows behind panel)</summary>
    </key>

    <!-- ===== Taskbar Settings ===== -->
    <key name="icon-size" type="i">
      <default>32</default>
      <summary>Icon size</summary>
    </key>

    <key name="icon-margin" type="i">
      <default>4</default>
      <summary>Icon margin</summary>
    </key>

    <key name="show-favorites" type="b">
      <default>true</default>
      <summary>Show favorite apps</summary>
    </key>

    <key name="show-running-apps" type="b">
      <default>true</default>
      <summary>Show running apps</summary>
    </key>

    <key name="isolate-workspaces" type="b">
      <default>false</default>
      <summary>Isolate workspaces</summary>
    </key>

    <key name="click-action" type="s">
      <default>'TOGGLE'</default>
      <summary>Click action</summary>
    </key>

    <key name="enable-drag-drop" type="b">
      <default>true</default>
      <summary>Enable drag and drop reordering</summary>
    </key>

    <!-- ===== Window Preview ===== -->
    <key name="show-window-previews" type="b">
      <default>true</default>
      <summary>Show window previews on hover</summary>
    </key>

    <key name="preview-width" type="i">
      <default>240</default>
      <summary>Preview thumbnail width</summary>
    </key>

    <key name="preview-height" type="i">
      <default>160</default>
      <summary>Preview thumbnail height</summary>
    </key>

    <key name="preview-delay" type="i">
      <default>300</default>
      <summary>Delay before showing preview (ms)</summary>
    </key>

    <!-- ===== App Badges ===== -->
    <key name="show-app-badges" type="b">
      <default>true</default>
      <summary>Show notification count badges</summary>
    </key>

    <!-- ===== Context Menu ===== -->
    <key name="show-context-menu" type="b">
      <default>true</default>
      <summary>Show right-click context menu</summary>
    </key>

    <!-- ===== Clock Settings ===== -->
    <key name="clock-position" type="s">
      <default>'CENTER'</default>
      <summary>Clock position</summary>
    </key>

    <key name="clock-format" type="s">
      <default>'%H:%M'</default>
      <summary>Clock format</summary>
    </key>

    <key name="show-date" type="b">
      <default>true</default>
      <summary>Show date with clock</summary>
    </key>

    <!-- ===== Workspace Indicator ===== -->
    <key name="show-workspace-indicator" type="b">
      <default>true</default>
      <summary>Show workspace indicator</summary>
    </key>

    <!-- ===== Animations ===== -->
    <key name="animation-type" type="s">
      <default>'SLIDE'</default>
      <summary>Panel animation type: SLIDE, FADE, SCALE, NONE</summary>
    </key>

    <key name="animation-duration" type="i">
      <default>250</default>
      <summary>Animation duration in ms</summary>
    </key>

    <!-- ===== Saved icon order for drag-drop ===== -->
    <key name="icon-order" type="as">
      <default>[]</default>
      <summary>Custom icon order from drag and drop</summary>
    </key>

  </schema>
</schemalist>